{
  "name": "saturn",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "author": "Taylor Whatley",
  "scripts": {
    "wasm": "wasm-pack build ./src-wasm --out-dir ../src/utils/mips/wasm",
    "dev": "pnpm run wasm && vite",
    "build": "pnpm run wasm && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write . && cd src-backend && cargo fmt && cd ../src-tauri && cargo fmt && cd ../src-wasm && cargo fmt",
    "format-check": "prettier --check . && cd src-backend && cargo fmt --check && cd ../src-tauri && cargo fmt --check && cd ../src-wasm && cargo fmt --check",
    "cargo-bump": "cd src-backend && cargo update && cd ../src-tauri && cargo update && cd ../src-wasm && cargo update"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@heroicons/vue": "^2.2.0",
    "@lezer/generator": "^1.7.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "@replit/codemirror-minimap": "^0.5.2",
    "@replit/codemirror-vim": "^6.3.0",
    "@sentry/vue": "^9.13.0",
    "@tauri-apps/api": "^2.4.1",
    "@tauri-apps/plugin-deep-link": "^2.2.1",
    "codemirror": "^6.0.1",
    "date-fns": "^4.1.0",
    "fast-myers-diff": "^3.2.0",
    "fuse.js": "^7.1.0",
    "midicube": "^0.6.2",
    "reka-ui": "2.2.0",
    "uuid": "^10.0.0",
    "vue": "^3.5.13",
    "y-codemirror.next": "^0.3.5",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.24"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.1",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "vue-tsc": "^2.2.8",
    "wasm-pack": "^0.13.1"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "patchedDependencies": {
      "y-codemirror.next": "patches/y-codemirror.next.patch"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "wasm-pack"
    ]
  }
}
